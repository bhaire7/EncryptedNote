package ui.Admin;

import database.NoteDB;
import database.UserDB;
import org.bson.Document;
import ui.LogInRegisterUI.Mainframe;

import javax.swing.*;
import javax.swing.border.Border;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.util.List;

public class AdminPanel extends JFrame {

    private JList<String> userList;
    private DefaultListModel<String> listModel;
    private JTextField usernameField;
    private JTextField emailField;
    private JPasswordField passwordField;
    private JButton saveButton;
    private JButton deleteButton;

    private List<Document> allUsers;
    private Document selectedUser;

    public AdminPanel() {
        setTitle("Admin Panel");
        setSize(1000, 700);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        // Main Split Pane
        JSplitPane splitPane = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT);
        splitPane.setDividerLocation(300);
        splitPane.setEnabled(false);

        // Left Panel (User List)
        JPanel leftPanel = createLeftPanel();
        splitPane.setLeftComponent(leftPanel);

        // Right Panel (User Details)
        JPanel rightPanel = createRightPanel();
        splitPane.setRightComponent(rightPanel);

        add(splitPane);

        loadUsers();

        userList.addListSelectionListener(e -> {
            if (!e.getValueIsAdjusting()) {
                int selectedIndex = userList.getSelectedIndex();
                if (selectedIndex != -1) {
                    selectedUser = allUsers.get(selectedIndex);
                    displayUserDetails();
                }
            }
        });
    }

    private JPanel createLeftPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));
        panel.setBorder(new EmptyBorder(15, 15, 15, 15));
        panel.setBackground(new Color(245, 245, 255));

        // Header
        JPanel headerPanel = new JPanel(new BorderLayout());
        headerPanel.setOpaque(false);
        JLabel titleLabel = new JLabel("Registered Users");
        titleLabel.setFont(new Font("Montserrat", Font.BOLD, 24));
        titleLabel.setForeground(new Color(50, 50, 90));
        JButton logoutButton = createStyledButton("Logout", new Color(0xEF5350), Color.WHITE);
        logoutButton.addActionListener(e -> {
            dispose();
            new Mainframe();
        });
        headerPanel.add(titleLabel, BorderLayout.CENTER);
        headerPanel.add(logoutButton, BorderLayout.EAST);

        // User List
        listModel = new DefaultListModel<>();
        userList = new JList<>(listModel);
        userList.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        userList.setCellRenderer(new UserListCellRenderer());
        JScrollPane listScrollPane = new JScrollPane(userList);
        listScrollPane.setBorder(BorderFactory.createLineBorder(new Color(220, 220, 230)));

        panel.add(headerPanel, BorderLayout.NORTH);
        panel.add(listScrollPane, BorderLayout.CENTER);
        return panel;
    }

    private JPanel createRightPanel() {
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBorder(new EmptyBorder(30, 40, 30, 40));
        panel.setBackground(new Color(230, 240, 255));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10, 10, 10, 10);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.gridwidth = 2;

        // Title
        JLabel titleLabel = new JLabel("Edit User Details");
        titleLabel.setFont(new Font("Montserrat", Font.BOLD, 28));
        titleLabel.setForeground(new Color(50, 50, 90));
        gbc.gridx = 0;
        gbc.gridy = 0;
        panel.add(titleLabel, gbc);

        // Form Fields
        gbc.gridwidth = 1;
        gbc.anchor = GridBagConstraints.LINE_END;
        gbc.gridy = 1;
        panel.add(createLabel("Username:"), gbc);
        gbc.gridy = 2;
        panel.add(createLabel("Email:"), gbc);
        gbc.gridy = 3;
        panel.add(createLabel("New Password:"), gbc);

        gbc.gridx = 1;
        gbc.anchor = GridBagConstraints.LINE_START;
        usernameField = createTextField();
        emailField = createTextField();
        passwordField = new JPasswordField(20);
        styleField(passwordField);

        gbc.gridy = 1;
        panel.add(usernameField, gbc);
        gbc.gridy = 2;
        panel.add(emailField, gbc);
        gbc.gridy = 3;
        panel.add(passwordField, gbc);

        // Buttons
        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 20, 10));
        buttonPanel.setOpaque(false);
        saveButton = createStyledButton("Save Changes", new Color(0x00BFA5), Color.WHITE);
        deleteButton = createStyledButton("Delete User", new Color(0xEF5350), Color.WHITE);
        buttonPanel.add(saveButton);
        buttonPanel.add(deleteButton);

        gbc.gridx = 0;
        gbc.gridy = 4;
        gbc.gridwidth = 2;
        gbc.anchor = GridBagConstraints.CENTER;
        panel.add(buttonPanel, gbc);

        // Action Listeners
        saveButton.addActionListener(e -> saveUserChanges());
        deleteButton.addActionListener(e -> deleteUser());

        return panel;
    }

    private void loadUsers() {
        allUsers = UserDB.getAllUsers();
        listModel.clear();
        for (Document user : allUsers) {
            listModel.addElement(user.getString("user_name"));
        }
    }

    private void displayUserDetails() {
        if (selectedUser != null) {
            usernameField.setText(selectedUser.getString("user_name"));
            emailField.setText(selectedUser.getString("email"));
            passwordField.setText(""); // Clear for security
            saveButton.setEnabled(true);
            deleteButton.setEnabled(true);
        } else {
            usernameField.setText("");
            emailField.setText("");
            passwordField.setText("");
            saveButton.setEnabled(false);
            deleteButton.setEnabled(false);
        }
    }

    private void saveUserChanges() {
        if (selectedUser == null) return;

        String originalEmail = selectedUser.getString("email");
        String newUsername = usernameField.getText().trim();
        String newEmail = emailField.getText().trim();
        String newPassword = new String(passwordField.getPassword());

        if (newUsername.isEmpty() || newEmail.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Username and Email cannot be empty.", "Validation Error", JOptionPane.ERROR_MESSAGE);
            return;
        }

        UserDB.updateUser(originalEmail, newUsername, newEmail, newPassword);
        JOptionPane.showMessageDialog(this, "User updated successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);
        loadUsers(); // Refresh the list
        clearSelection();
    }

    private void deleteUser() {
        if (selectedUser == null) return;

        int choice = JOptionPane.showConfirmDialog(this,
                "Are you sure you want to delete this user and all their notes?\nThis action cannot be undone.",
                "Confirm Deletion", JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

        if (choice == JOptionPane.YES_OPTION) {
            String username = selectedUser.getString("user_name");
            String email = selectedUser.getString("email");

            // Delete from LoginInfo database
            UserDB.deleteUser(email);
            // Drop the user's notes database
            NoteDB.dropUserDatabase(username);

            JOptionPane.showMessageDialog(this, "User '" + username + "' has been deleted.", "Success", JOptionPane.INFORMATION_MESSAGE);
            loadUsers();
            clearSelection();
        }
    }

    private void clearSelection() {
        userList.clearSelection();
        selectedUser = null;
        displayUserDetails();
    }

    // --- UI Helper Methods ---

    private JLabel createLabel(String text) {
        JLabel label = new JLabel(text);
        label.setFont(new Font("Montserrat", Font.BOLD, 16));
        label.setForeground(new Color(50, 50, 90));
        return label;
    }

    private JTextField createTextField() {
        JTextField field = new JTextField(20);
        styleField(field);
        return field;
    }

    private void styleField(JComponent field) {
        field.setFont(new Font("Lato", Font.PLAIN, 16));
        field.setOpaque(false);
        Border line = BorderFactory.createMatteBorder(0, 0, 2, 0, new Color(120, 150, 220));
        Border padding = BorderFactory.createEmptyBorder(5, 5, 5, 5);
        field.setBorder(BorderFactory.createCompoundBorder(line, padding));
    }

    private JButton createStyledButton(String text, Color bgColor, Color fgColor) {
        JButton button = new JButton(text);
        button.setBackground(bgColor);
        button.setForeground(fgColor);
        button.setFont(new Font("Montserrat", Font.BOLD, 14));
        button.setFocusPainted(false);
        button.setBorder(new EmptyBorder(12, 25, 12, 25));
        button.addMouseListener(new java.awt.event.MouseAdapter() {
            public void mouseEntered(java.awt.event.MouseEvent evt) {
                button.setBackground(bgColor.darker());
            }
            public void mouseExited(java.awt.event.MouseEvent evt) {
                button.setBackground(bgColor);
            }
        });
        return button;
    }

    // Custom cell renderer for the JList
    private static class UserListCellRenderer extends DefaultListCellRenderer {
        @Override
        public Component getListCellRendererComponent(JList<?> list, Object value, int index, boolean isSelected, boolean cellHasFocus) {
            JLabel label = (JLabel) super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
            label.setFont(new Font("Lato", Font.BOLD, 18));
            label.setBorder(new EmptyBorder(12, 15, 12, 15));
            label.setOpaque(true);

            if (isSelected) {
                label.setBackground(new Color(120, 150, 220));
                label.setForeground(Color.WHITE);
            } else {
                label.setBackground(index % 2 == 0 ? new Color(250, 250, 255) : new Color(245, 245, 250));
                label.setForeground(new Color(70, 70, 110));
            }
            return label;
        }
    }
}